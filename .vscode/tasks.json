{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Backend Dependencies",
      "type": "shell",
      "command": "python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install All Dependencies",
      "dependsOn": ["Install Backend Dependencies", "Install Frontend Dependencies"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Backend (FastAPI)",
      "type": "shell",
      "command": ". .venv/bin/activate && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^(.*)$", "file": 1, "line": 2, "column": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process|Application startup complete",
          "endsPattern": "Uvicorn running on"
        }
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "vridh-mitra"
      }
    },
    {
      "label": "Run Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^(.*)$", "file": 1, "line": 2, "column": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting...",
          "endsPattern": "Ready in"
        }
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "group": "vridh-mitra"
      }
    },
    {
      "label": "Run Both (Backend + Frontend)",
      "dependsOn": ["Run Backend (FastAPI)", "Run Frontend (Next.js)"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Backend Tests (pytest)",
      "type": "shell",
      "command": ". .venv/bin/activate && pytest -v",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build Frontend (production)",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Open Browser",
      "type": "shell",
      "command": "echo Opening app... && (command -v xdg-open >/dev/null && xdg-open http://localhost:3000 || command -v open >/dev/null && open http://localhost:3000 || echo Open http://localhost:3000 in your browser)",
      "group": "test",
      "problemMatcher": []
    }
  ]
}